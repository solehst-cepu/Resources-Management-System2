# ==============================================================================
# LAZUARDI RESOURCES MANAGEMENT SYSTEM (LRMS) — ENVIRONMENT VARIABLES
# ==============================================================================
# Salin file ini menjadi .env (lokal) atau konfigurasikan pada Vercel Dashboard.
# JANGAN PERNAH menyimpan secret asli di GitHub repository.

# ------------------------------------------------------------------------------
# 1. URL Aplikasi (Development & Production)
# ------------------------------------------------------------------------------
# AI Studio otomatis menyuntikkan APP_URL saat runtime.
# Untuk Vercel production, isi dengan domain produksi Anda (mis. https://lrms.lazuardi.sch.id)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Public Client — Aman untuk Frontend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. Supabase Server Configuration (WAJIB SERVER-SIDE ONLY — JANGAN PREFIX VITE_)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="fotokopi-documents"

# ------------------------------------------------------------------------------
# 4. Keamanan & Kebijakan Domain Sekolah
# ------------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN="lazuardi.sch.id"
# Secret acak minimal 32 karakter untuk signing cookie sesi pengembangan / CSRF
SESSION_SECRET="replace-with-strong-random-32-char-secret"
# Secret untuk otentikasi Vercel Cron / Scheduled Job pengiriman laporan bulanan
CRON_SECRET="replace-with-strong-cron-secret"

# ------------------------------------------------------------------------------
# 5. Layanan Email Server-Side (Untuk Pengiriman Laporan Bulanan Kepala Unit)
# ------------------------------------------------------------------------------
# Opsi A: Resend API (Disarankan untuk Vercel Serverless)
RESEND_API_KEY=""
EMAIL_FROM="Divisi Resources Lazuardi <resources@lazuardi.sch.id>"

# Opsi B: SMTP Sekolah / Google Workspace Relay (Alternatif jika tidak memakai Resend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
